CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# CONFIG_USB_DWC3_QCOM is not set

# msm-5.4 era DCVS/debug drivers that msm-5.10 replaced (QCOM_MEMLAT,
# QCOM_BWMON, dcvs): not built for now.
# CONFIG_ARM_MEMLAT_MON is not set
# CONFIG_DEVFREQ_GOV_MEMLAT is not set
# CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON is not set
# CONFIG_QCOM_BIMC_BWMON is not set
# CONFIG_QTI_HW_MEMLAT is not set
# CONFIG_QTI_HW_MEMLAT_SCMI_CLIENT is not set
# CONFIG_QTI_HW_MEMLAT_LOG is not set
# CONFIG_QCOM_MICRODUMP is not set

# Bring-up: no LTO/CFI. CFI needs LTO, and CFI type mismatches in the
# forward-ported vendor code would panic at runtime. Revisit after boot.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_CFI_CLANG is not set

# Xiaomi ultrasound proximity (techpack/audio)
CONFIG_MIUS_PROXIMITY=y

# lahaina TSENS (qcom,tsens24xx)
CONFIG_THERMAL_TSENS=y

# Providers of symbols the built-in drivers above need (=m in lahaina_GKI)
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_QCOM_DCVS=y
# CONFIG_QCOM_MEM_BUF is not set (needs Gunyah)
CONFIG_QCOM_MEM_BUF_DEV=y
CONFIG_QCOM_RAMDUMP=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y
CONFIG_QCOM_PMU_LIB=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_REGULATOR_DEBUG_CONTROL=y
CONFIG_QCOM_GDSC_REGULATOR=y
CONFIG_MHI_DTR=y
CONFIG_REGMAP_QTI_DEBUGFS=y
# WALT built in like on the 5.4 haydn kernel (KGSL, msm_performance and
# the LPM cpuidle governor call into it)
CONFIG_SCHED_WALT=y
CONFIG_MSM_PERFORMANCE=y
# lahaina has no TME: HWKM v1 (see drivers/soc/qcom/hwkm)
# CONFIG_MSM_TMECOM_QMP is not set
# No Gunyah on lahaina (it runs the older Haven hypervisor)
# CONFIG_GUNYAH_DRIVERS is not set

# FBE: lahaina HWKM v1 (wrappedkey_v0 in the haydn fstab)
CONFIG_QTI_HW_KEY_MANAGER_V1=y

# msm-5.4 ALSA/ASoC extensions for the lahaina APR audio techpack
CONFIG_AUDIO_QGKI=y

# WLAN host driver (QCA6490), module like on 5.4
CONFIG_QCA_CLD_WLAN=m

# Not lahaina/haydn hardware, or test/debug only: never built on msm-5.4
# haydn and not wanted in the vendor_boot module set
# CONFIG_QCOM_ADSP_SLEEPMON is not set
# CONFIG_QCOM_BAM_DMA is not set
# CONFIG_QCOM_BWMON is not set
# CONFIG_QCOM_MEMLAT is not set
# CONFIG_QTI_C1DCVS_SCMI_CLIENT is not set
# CONFIG_QTI_SCMI_C1DCVS_PROTOCOL is not set
