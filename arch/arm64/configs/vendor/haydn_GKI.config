# Xiaomi haydn (Mi 11X Pro / Redmi K40 Pro+) on msm-5.10 lahaina.
# Applied after gki_defconfig + vendor/lahaina_GKI.config.

CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Touchscreen (Focaltech FT3658 over SPI) + Xiaomi touch feature node
CONFIG_TOUCHSCREEN_FOCALTECH=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_FTS_TRUSTED_TOUCH is not set
# CONFIG_NOVATEK_TRUSTED_TOUCH is not set

# Fingerprint (FPC, side mounted)
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=m

# Haptics
CONFIG_INPUT_QCOM_HV_HAPTICS=m

# Charging (Xiaomi pmic-glink battery charger + BQ2597X charge pump)
CONFIG_QTI_BATTERY_CHARGER=m
CONFIG_BQ2597X=y

# Xiaomi misc
CONFIG_MI_HARDWARE_ID=m
CONFIG_MI_THERMAL_INTERFACE=m

# IR blaster
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=m

# WLAN QCA6490 (PCIe)
CONFIG_CNSS2=m
CONFIG_CNSS_QCA6490=y

# Flash LED
CONFIG_LEDS_QTI_FLASH=m

CONFIG_ZRAM=m
