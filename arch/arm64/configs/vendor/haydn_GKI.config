CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y
CONFIG_CFG80211=y
CONFIG_CHR_DEV_SG=y
CONFIG_CLD_LL_CORE=y
CONFIG_CNSS_ASYNC=y
CONFIG_CNSS_GENL=y
CONFIG_CNSS_QMI_SVC=y
CONFIG_CNSS_UTILS=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_CPU_IDLE_GOV_QCOM_LPM=y
