# haydn 5.10 bring-up diagnostics: kernel log on the bootloader splash
# framebuffer (simplefb + fbcon), and stay on the panic screen.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem console=tty0 loglevel=4 fbcon=font:TER16x32 clk_ignore_unused pd_ignore_unused arm-smmu.disable_bypass=0 printk.devkmsg=on"

# logdump boot logger (from xiaomi-lahaina-devs/5.10-sm8350-H)
CONFIG_HAYDN_BOOTLOG=y
CONFIG_HAYDN_LOGCAP=y

# Test the msm-5.4 era CPU/LLCC/DDR scaling governors the lahaina DT asks
# for (mem_latency, compute, bw_hwmon). Without them every devfreq-icc
# device fails with "Unable to find governor" and memory/L3/LLCC bandwidth
# never scales with load. Diag only until it is known to boot.
CONFIG_ARM_MEMLAT_MON=y
CONFIG_DEVFREQ_GOV_MEMLAT=y
CONFIG_QCOM_BIMC_BWMON=y
CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON=y
