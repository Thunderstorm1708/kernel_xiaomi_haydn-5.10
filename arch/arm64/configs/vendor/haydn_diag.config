# haydn 5.10 bring-up diagnostics: kernel log on the bootloader splash
# framebuffer (simplefb + fbcon), and stay on the panic screen.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem loglevel=4 clk_ignore_unused pd_ignore_unused arm-smmu.disable_bypass=0 printk.devkmsg=on msm_geni_serial.haydn_uart_dbg=1 pcie_aspm.policy=powersave msm_kgsl.tlb_flush_slumber=1 haydn_pm_sdam=1"

# logdump boot logger (from xiaomi-lahaina-devs/5.10-sm8350-H)
CONFIG_HAYDN_BOOTLOG=y
CONFIG_HAYDN_LOGCAP=y

# Test the msm-5.4 era CPU-L3/LLCC/DDR latency governors the lahaina DT
# asks for (mem_latency, compute). Without them the devfreq-icc latency
# devices fail with "Unable to find governor" and L3/LLCC/DDR never scale
# with CPU load. bw_hwmon (3 bandwidth nodes) needs more porting
# (trace events, devfreq min/max_freq) and stays off. Diag only until it
# is known to boot.
CONFIG_ARM_MEMLAT_MON=y
CONFIG_DEVFREQ_GOV_MEMLAT=y
# bw_hwmon for the 3 bandwidth nodes (cpu-cpu-llcc-bw, cpu-llcc-ddr-bw,
# snoop-l3-bw); the ROM's power HAL boosts them through min_freq
CONFIG_QCOM_BIMC_BWMON=y
CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON=y
# Suspend hang hunter: panic (saved by ramoops, copied into the next boot's
# log by bootlog) if a device's suspend/resume callback takes > 5 s.
CONFIG_EXPERT=y
CONFIG_PM_DEBUG=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=5
# KernelSU-Next v3.4.2 (built in, diag only): root for live GPU/camera/BT debugging
CONFIG_KSU=y
CONFIG_HAYDN_BOOTLOG=n
