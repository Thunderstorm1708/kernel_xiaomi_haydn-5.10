# haydn 5.10 bring-up diagnostics: kernel log on the bootloader splash
# framebuffer (simplefb + fbcon), and stay on the panic screen.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem console=tty0 ignore_loglevel fbcon=font:TER16x32 clk_ignore_unused pd_ignore_unused arm-smmu.disable_bypass=0"

# logdump boot logger (from xiaomi-lahaina-devs/5.10-sm8350-H)
CONFIG_HAYDN_BOOTLOG=y
